# Local overrides only. On GitHub Pages the deploy workflow
# (.github/workflows/deploy.yml) sets these for you.

# Contact form backend: a URL that accepts a form POST and answers JSON, such as a
# Formspree form endpoint (https://formspree.io/f/xxxxxxxx). Without it the form
# opens the visitor's email app instead. On GitHub, add it as the repository
# variable CONTACT_ENDPOINT (Settings → Secrets and variables → Actions → Variables).
NEXT_PUBLIC_CONTACT_ENDPOINT=

# Set by the workflow from the Pages configuration; leave empty locally.
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_SITE_URL=
